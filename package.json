{
  "name": "unionize-software",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "unionize-software": "./bin/unionize-software.mjs",
    "unionize-mcp": "./bin/unionize-mcp.mjs"
  },
  "packageManager": "pnpm@10.19.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/unionize-software/unionize.software.git"
  },
  "homepage": "https://unionize.software",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "tsx scripts/clean-next-build.ts && next build && tsx scripts/generate-resource-search-index.ts",
    "start": "next start",
    "lint": "next lint",
    "test": "playwright test",
    "pagefind": "tsx scripts/generate-pagefind-index.ts",
    "decrypt-intake": "tsx scripts/decrypt-intake.ts",
    "purge-expired-intakes": "tsx scripts/purge-expired-intakes.ts",
    "print-intake-key-fingerprint": "tsx scripts/print-intake-key-fingerprint.ts",
    "unionize": "tsx scripts/unionize-cli.ts",
    "test:mcp": "node scripts/mcp-smoke-test.mjs",
    "test:mcp:integration": "node scripts/mcp-integration-test.mjs",
    "sync:mcp-package": "node scripts/sync-mcp-package.mjs",
    "check:mcp-package": "node scripts/sync-mcp-package.mjs --check",
    "content:audit": "tsx scripts/audit-editorial-content.ts",
    "states:audit": "node --experimental-strip-types scripts/audit-state-resources.ts",
    "mcp:serve": "tsx scripts/unionize-cli.ts mcp serve"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1098.0",
    "@aws-sdk/client-s3": "^3.1098.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@radix-ui/react-slot": "^1.3.3",
    "@supabase/supabase-js": "^2.111.0",
    "better-sqlite3": "^13.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "gray-matter": "^4.0.3",
    "libsodium": "^0.8.4",
    "libsodium-wrappers": "^0.8.4",
    "lucide-react": "^1.27.0",
    "next": "^16.2.12",
    "next-mdx-remote": "^6.0.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.23.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.3.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.1.7",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.34.0",
    "eslint-config-next": "^15.5.2",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.9.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}
